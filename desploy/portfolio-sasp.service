[Unit]
Description=sasp Portfolio Flask Application
After=network.target

[Service]
Type=simple
User=gabo
Group=gabo
WorkingDirectory=/home/gabo/portfolio/projects/05-sasp
Environment=PYTHONUNBUFFERED=1
Environment=SCIL_DB=/home/gabo/portfolio/projects/05-sasp/scil.db
EnvironmentFile=-/etc/default/portfolio-sasp
ExecStart=/home/gabo/portfolio/projects/05-sasp/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:5004 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile - \
    app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

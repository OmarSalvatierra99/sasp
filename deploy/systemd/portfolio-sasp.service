[Unit]
Description=SASP — Sistema de Auditoría de Servicios Personales
After=network.target

[Service]
Type=simple
User=gabo
Group=gabo
WorkingDirectory=/home/gabo/portfolio/projects/05-sasp
EnvironmentFile=/etc/default/portfolio-sasp
ExecStart=/home/gabo/portfolio/projects/05-sasp/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:${PORT} \
    --timeout 120 \
    --access-logfile logs/gunicorn-access.log \
    --error-logfile logs/gunicorn-error.log \
    app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
